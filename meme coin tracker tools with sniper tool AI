pragma solidity ^0.8.24;

contract MemeGuardAI {

    address public owner;

    struct Token {
        address tokenAddress;
        string name;
        string symbol;
        uint256 addedAt;
        uint256 riskScore;
        bool analyzed;
    }

    mapping(address => Token) public tokens;

    address[] public tokenList;

    event TokenAdded(
        address indexed token,
        string name,
        string symbol
    );

    event RiskUpdated(
        address indexed token,
        uint256 riskScore
    );

    modifier onlyOwner() {
        require(msg.sender == owner, "Not authorized");
        _;
    }

    constructor() {
        owner = msg.sender;
    }

    function addToken(
        address token,
        string memory name,
        string memory symbol
    ) external onlyOwner {

        require(token != address(0), "Invalid token");
        require(tokens[token].addedAt == 0, "Already tracked");

        tokens[token] = Token({
            tokenAddress: token,
            name: name,
            symbol: symbol,
            addedAt: block.timestamp,
            riskScore: 0,
            analyzed: false
        });

        tokenList.push(token);

        emit TokenAdded(token, name, symbol);
    }

    function updateRisk(
        address token,
        uint256 score
    ) external onlyOwner {

        require(tokens[token].addedAt != 0, "Not tracked");
        require(score <= 100, "Invalid score");

        tokens[token].riskScore = score;
        tokens[token].analyzed = true;

        emit RiskUpdated(token, score);
    }

    function getTokenCount()
        external
        view
        returns (uint256)
    {
        return tokenList.length;
    }

    function getToken(
        address token
    ) external view returns (Token memory) {
        return tokens[token];
    }
}
